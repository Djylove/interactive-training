FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TOKENIZERS_PARALLELISM=false \
    IT2_DEMO_ASSETS=/app/demo/assets \
    IT2_SESSION_ROOT=/var/lib/interactive-training/sessions \
    IT2_AIM_REPO=/var/lib/interactive-training/aim-repo

WORKDIR /app
COPY . .

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir ".[transport,aim,hf]" \
    && python -m pip install --no-cache-dir "./demo/gateway[trainer]"

EXPOSE 39081

CMD ["uvicorn", "it2_demo.app:app", "--host", "0.0.0.0", "--port", "39081", "--workers", "1"]
