FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY . .

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e ".[transport,dev]" \
    && python -m pip install --no-cache-dir -e "demo/gateway[dev]"

CMD ["sh", "-c", "python tests/run_tests.py && python -m pytest demo/gateway/tests"]
